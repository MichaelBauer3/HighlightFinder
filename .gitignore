# .gitignore

# Credentials
src/app/config/local_settings.json
.env
*.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/

# Data files
data/recordings/*.mp4
data/recordings/*.avi
*.mp4
*.avi

# Keep directory structure but ignore video files
!data/recordings/.gitkeep
!data/clips/.gitkeep
!data/metadata/.gitkeep
!data/digits/raw/.gitkeep
!data/digits/labeled/.gitkeep

src/app/ml/*.keras
src/app/ml/*.tflite

secrets/

# Logs
logs/*.log
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/
